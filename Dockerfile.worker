FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund
COPY worker ./worker
COPY src/services/ingestFormatting.ts src/services/githubRateLimit.ts ./src/services/
COPY src/types ./src/types
RUN node node_modules/esbuild/bin/esbuild worker/server.ts --bundle --platform=node --format=esm --packages=external --outfile=worker.mjs \
    && npm prune --omit=dev --legacy-peer-deps --no-audit --no-fund

FROM node:22-slim
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/worker.mjs ./worker.mjs
ENV NODE_ENV=production INGEST_DATA_DIR=/data INGEST_WORKER_PORT=3001
VOLUME /data
EXPOSE 3001
CMD ["node", "worker.mjs"]
